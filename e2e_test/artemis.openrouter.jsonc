{
  // Cấu hình Artemis dùng OpenRouter cho các agent chính.
  // Kích hoạt bằng biến môi trường ARTEMIS_ARTEMIS_JSONC=<đường dẫn tuyệt đối tới file này>
  // (file này THAY THẾ toàn bộ artemis.jsonc mặc định, không gộp).
  // Key: OPEN_ROUTER_API_KEY trong e2e_test/.env.
  //
  // Dùng định dạng đầy đủ (có "planner" + "utils") vì định dạng "default"/"nodes"
  // bỏ qua validator_pixel_safety_net và planner_validation (chúng sẽ rơi về Google).
  //
  // Những phần Artemis chỉ gọi thẳng Google (vẫn cần GEMINI_API_KEY):
  //  - utils.object_detector (gemini-robotics-er, OpenRouter không có model ER)
  //  - agent.flash.step_summarizer / agent.memory.chunking (chạy nền, lỗi không làm hỏng task)
  //
  // Tài khoản OpenRouter hiện có 0 credit nên chỉ dùng model ":free"
  // (giới hạn ~20 request/phút, ~50 request/ngày). Nạp >= 10 USD để lên 1000 request/ngày,
  // hoặc đổi sang model trả phí như "google/gemini-3.7-flash".

  "planner":                 { "provider": "openrouter", "model": "google/gemma-4-31b-it:free", "fallback": { "provider": "openrouter", "model": "nvidia/nemotron-3.5-super-vl:free" } },
  "summarizer":              { "provider": "openrouter", "model": "google/gemma-4-31b-it:free", "fallback": { "provider": "openrouter", "model": "nvidia/nemotron-3.5-super-vl:free" } },
  "operator":                { "provider": "openrouter", "model": "google/gemma-4-31b-it:free", "fallback": { "provider": "openrouter", "model": "nvidia/nemotron-3.5-super-vl:free" } },
  "operator_summarizer":     { "provider": "openrouter", "model": "google/gemma-4-31b-it:free", "fallback": { "provider": "openrouter", "model": "nvidia/nemotron-3.5-super-vl:free" } },
  "log_reader_sub_agent":    { "provider": "openrouter", "model": "google/gemma-4-31b-it:free", "fallback": { "provider": "openrouter", "model": "nvidia/nemotron-3.5-super-vl:free" } },
  "log_analyzer":            { "provider": "openrouter", "model": "google/gemma-4-31b-it:free", "fallback": { "provider": "openrouter", "model": "nvidia/nemotron-3.5-super-vl:free" } },
  "diagnoser":               { "provider": "openrouter", "model": "google/gemma-4-31b-it:free", "fallback": { "provider": "openrouter", "model": "nvidia/nemotron-3.5-super-vl:free" } },
  "checker":                 { "provider": "openrouter", "model": "google/gemma-4-31b-it:free", "fallback": { "provider": "openrouter", "model": "nvidia/nemotron-3.5-super-vl:free" } },
  "planner_avatar":          { "provider": "openrouter", "model": "google/gemma-4-31b-it:free", "fallback": { "provider": "openrouter", "model": "nvidia/nemotron-3.5-super-vl:free" } },
  "history_analyzer_expert": { "provider": "openrouter", "model": "google/gemma-4-31b-it:free", "fallback": { "provider": "openrouter", "model": "nvidia/nemotron-3.5-super-vl:free" } },
  "diagnoser_expert":        { "provider": "openrouter", "model": "google/gemma-4-31b-it:free", "fallback": { "provider": "openrouter", "model": "nvidia/nemotron-3.5-super-vl:free" } },
  "explorer":                { "provider": "openrouter", "model": "google/gemma-4-31b-it:free", "fallback": { "provider": "openrouter", "model": "nvidia/nemotron-3.5-super-vl:free" } },

  "validator_pixel_safety_net": { "provider": "openrouter", "model": "google/gemma-4-26b-a4b-it:free", "temperature": 0.0, "fallback": { "provider": "openrouter", "model": "google/gemma-4-31b-it:free", "temperature": 0.0 } },
  "planner_validation":         { "provider": "openrouter", "model": "google/gemma-4-26b-a4b-it:free", "temperature": 0.0, "fallback": { "provider": "openrouter", "model": "google/gemma-4-31b-it:free", "temperature": 0.0 } },

  "utils": {
    "outputter":       { "provider": "openrouter", "model": "google/gemma-4-31b-it:free", "fallback": { "provider": "openrouter", "model": "nvidia/nemotron-3.5-super-vl:free" } },
    "hopper":          { "provider": "openrouter", "model": "google/gemma-4-26b-a4b-it:free", "fallback": { "provider": "openrouter", "model": "google/gemma-4-31b-it:free" } },
    "video_analyzer":  { "provider": "openrouter", "model": "google/gemma-4-31b-it:free", "fallback": { "provider": "openrouter", "model": "nvidia/nemotron-3.5-super-vl:free" } },
    "object_detector": { "provider": "google", "model": "gemini-robotics-er-2-preview", "fallback": { "provider": "google", "model": "gemini-robotics-er-2-preview" } }
  },

  "agent": {
    "flash": {
      "max_turns": 0,
      "explorer_mode": "flash",
      "step_summarizer": {
        "enabled": true,
        "model": "gemini-3.5-flash-lite",
        "prune_history_xml": true
      }
    },
    "pro": {
      "explorer": {
        "mode": "flash"
      },
      "planner_validation": {
        "enabled": false
      },
      "committee": {
        "enabled": false,
        "debate_rounds": 2
      },
      "checker": {
        "enabled": true,
        "midway_checks": false,
        "final_check": true,
        "max_iterations": 20,
        "final_check_max_attempts": 3,
        "checkpoint_max_repairs": 2,
        "max_concurrent_checkpoints": 3,
        "checkpoint_timeout": 180.0,
        "settlement_timeout": 120.0,
        "assert_failure_policy": "continue",
        "device_probes": true
      },
      "video_analyzer": {
        "enabled": false,
        "enable_ledger": true
      }
    },
    "memory": {
      "runtime": {
        "max_concurrency": 2,
        "retry_limit": 3,
        "flush_timeout_s": 30
      },
      "transcript": {
        "enabled": true,
        "context_budget_tokens": 80000,
        "start_ratio": 0.35,
        "soft_ratio": 0.7,
        "hard_ratio": 0.9,
        "min_active_steps": 5,
        "image_scrub_depth": 3,
        "image_scrub_depth_relaxed": 6,
        "pending_grace_steps": 3,
        "xml_scrub_depth": 1,
        "similarity_hint": true,
        "similarity_max_distance": 5
      },
      "chunking": {
        "max_steps": 12,
        "min_steps": 3,
        "target_source_tokens": 2000,
        "model": "gemini-3.7-flash",
        "max_chunks": 8
      },
      "recall": {
        "enabled": true,
        "max_results": 5,
        "max_text_tokens": 2000,
        "screen_scan_steps": 150
      },
      "replay": {
        "max_steps": 5,
        "max_tokens": 12000
      }
    },
    "video_analyzer": {
      "enabled": false,
      "enable_ledger": true
    },
    "outputter": {
      "enabled": true,
      "force_synthesis": false
    },
    "explorer": {
      "default_version": "flash"
    },
    "explorer_versions": {},
    "denylisted_tools": {
      "explorer": []
    }
  }
}
