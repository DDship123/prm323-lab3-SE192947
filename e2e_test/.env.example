# Sao chép thành e2e_test/.env rồi điền key thật (file .env đã được gitignore).
GEMINI_API_KEY=

# Tuỳ chọn
# ANDROID_SERIAL=emulator-5554
# E2E_PROFILE=flash        # flash (nhanh, rẻ) hoặc pro (có Checker)
# E2E_REPEAT=3             # số lần chạy lại mỗi test case
# E2E_TASK_TIMEOUT=900     # giây, timeout cho mỗi test case
# E2E_EXPLORE_MINUTES=25   # thời lượng phiên khám phá tự do
