        <mxCell id="note_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="260" width="730" x="1370" y="1065" as="geometry" />
        </mxCell>
        <mxCell id="note_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#1E40AF;" value="NGUYÊN TẮC THIẾT KẾ MVVM - DỰ ÁN PRM393 LAB 3" vertex="1">
          <mxGeometry height="25" width="600" x="1390" y="1075" as="geometry" />
        </mxCell>
        <mxCell id="note_content" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#1E3A8A;lineHeight=145%;" value="• &lt;b&gt;Loose Coupling (Phụ thuộc lỏng lẻo):&lt;/b&gt; View hoàn toàn không biết đến nguồn gốc dữ liệu (Backend, Firebase hay Local Database). Services và Models không phụ thuộc vào Flutter BuildContext, giúp việc tái sử dụng mã nguồn đạt mức tối đa.&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Single Source of Truth (Nguồn chân lý duy nhất):&lt;/b&gt; Mọi trạng thái hiển thị (giỏ hàng, đơn hàng, người dùng) được tập trung tại ViewModel. View chỉ là hình chiếu trực quan của State tại thời điểm đó.&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;High Testability (Khả năng kiểm thử cao):&lt;/b&gt; Các ViewModel có thể được Unit Test độc lập 100% bằng cách Mocking các Services mà không cần khởi chạy môi trường UI Widget Flutter.&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Dependency Injection (DI) với MultiProvider:&lt;/b&gt; Toàn bộ Services và ViewModels được tiêm phụ thuộc tại gốc ứng dụng (AppBootstrap), giúp mã nguồn mở rộng dễ dàng và quản lý vòng đời bộ nhớ hiệu quả." vertex="1">
          <mxGeometry height="205" width="695" x="1390" y="1108" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
