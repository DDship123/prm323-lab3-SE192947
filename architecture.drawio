        <mxCell id="c_mobile" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Ứng dụng Mobile Sinh viên&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Container: Flutter (Android / iOS)]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Giao diện cho sinh viên: Tìm món, giỏ hàng nhóm, quét QR nhận món, thanh toán VietQR &amp; tích hợp Firebase SDK." vertex="1">
