        <mxCell id="c_api" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Máy chủ Backend API&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Container: Spring Boot 3 REST API Server]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Cung cấp RESTful Web Services xử lý logic nghiệp vụ toàn diện: Quản lý xác thực JWT, điều phối gom đơn theo tòa KTX, tính phí hoa hồng, xử lý khiếu nại bồi hoàn, kích hoạt FCM Push và nhận Webhook thanh toán." vertex="1">
          <mxGeometry height="130" width="600" x="670" y="480" as="geometry" />
        </mxCell>
        <mxCell id="c_db" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Cơ sở dữ liệu Quan hệ&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Container: PostgreSQL / MySQL]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Lưu trữ dữ liệu người dùng, phân quyền, danh mục quán ăn, thực đơn món, lịch sử đơn hàng gom, giao dịch thanh toán và hồ sơ khiếu nại." vertex="1">
          <mxGeometry height="135" width="310" x="610" y="685" as="geometry" />
