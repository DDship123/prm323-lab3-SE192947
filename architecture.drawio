        <mxCell id="c_web" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Cổng Web Quản Trị &amp; Canteen&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Container: Flutter Web / Portal]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Giao diện quản lý dành cho Chủ quán ăn và Quản trị viên KTX: Quản lý thực đơn món, duyệt đơn hàng, thẩm định khiếu nại &amp; xem báo cáo." vertex="1">
